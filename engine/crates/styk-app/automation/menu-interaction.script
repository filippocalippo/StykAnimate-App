styk-auto/1
# The application menus' interaction check (docs/native/menus.md): the mark opens its menu, a submenu opens beside its row, a row
# runs its command through Core::dispatch (Undo, Redo), a row whose feature is not ported answers and closes the menu, and a
# second press of the mark closes it. Run from the repository root:
#   STYK_BACKGROUND_WINDOW=1 stykanimate --size 1560x900 --clock fixed --automation engine/crates/styk-app/automation/menu-interaction.script
open ../../../tests/edit/startup.document.json
wait 5
resize 1560 900
edit 30
expect history 1
expect menus 0

# The mark opens the menu; pressing Edit opens its submenu beside it.
click mark
expect menus 1
menu press Edit
expect menus 2
screenshot ../../../../tmp/menus/edit-open.png
# Undo is a registry command: the row runs it on the project in front and the whole tree closes.
menu press Undo
expect menus 0
expect history 0

# Redo the same way.
click mark
menu press Edit
expect menus 2
menu press Redo
expect menus 0
expect history 1

# A row whose feature is not ported yet closes the menu and changes nothing.
click mark
menu press Export…
expect menus 0
expect history 1

# The mark's second press closes its menu.
click mark
expect menus 1
click mark
expect menus 0
